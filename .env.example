# =============================================
# TCG Poke Market — Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================

# --- Supabase (required) ---
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Stripe (required for payments) ---
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Site URL (required for redirects and absolute links) ---
# In production use your deployed domain, e.g. https://www.tcgpoke.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiveKit (required for live auctions) ---
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Cloudinary (required for image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- OpenAI (required for AI support/admin card ingestion) ---
OPENAI_API_KEY=sk-...

# --- Pokémon TCG API (optional — enables live card pricing) ---
# Apply at: https://developer.pokemontcg.io/
POKEMON_TCG_API_KEY=
POKEMON_TCG_API_TOKEN=

# --- TCGPlayer API (optional — enables live card pricing) ---
TCGPLAYER_API_KEY=
TCGPLAYER_API_SECRET=

# --- eBay Browse API (optional — enables sold price data) ---
# Create app at: https://developer.ebay.com/
EBAY_APP_ID=

# --- USPS (required for shipping labels) ---
USPS_LABELS_URL=https://apis.usps.com/labels/v3/carrier-pickup
USPS_PAYMENT_AUTH_TOKEN=
USPS_PAYMENT_AUTHORIZATION_TOKEN=

# --- Admin ---
ADMIN_EMAILS=admin@example.com
CARD_INGESTION_STORAGE_BUCKET=card-ingestion-images
OPENAI_CARD_MODEL=gpt-4.1-mini
